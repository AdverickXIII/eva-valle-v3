# Copia este contenido en: Streamlit Cloud -> App -> Settings -> Secrets
# (o en .streamlit/secrets.toml para pruebas locales; ese archivo esta en .gitignore).
# Genera cada hash con:  python scripts/generar_hash.py <usuario> <rol>

[users.admin]
hash = "scrypt$32768$8$1$<sal_hex>$<hash_hex>"
role = "admin"

[users.analista]
hash = "scrypt$32768$8$1$<sal_hex>$<hash_hex>"
role = "analista"

[users.usuario]
hash = "scrypt$32768$8$1$<sal_hex>$<hash_hex>"
role = "usuario"
